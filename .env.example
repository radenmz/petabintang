# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Server
PORT=3000
NODE_ENV=development

# Midtrans (Track A3)
# Per Midtrans docs (current): sandbox & production keys are NOT distinguished
# by prefix anymore — both look like "Mid-server-…"/"Mid-client-…". Only the
# dashboard environment you copied from + the endpoint domain tell them apart.
# So set MIDTRANS_ENV explicitly to match the keys; it is decoupled from
# NODE_ENV (you can run a prod app build pointing at sandbox, and vice-versa).
#   sandbox → app.sandbox.midtrans.com (no real charges; test payment methods)
#   production → app.midtrans.com (real charges)
MIDTRANS_ENV=sandbox
VITE_MIDTRANS_ENV=sandbox
# SERVER_KEY is server-side only (NEVER expose to the browser).
# CLIENT_KEY is public-safe and shipped to the browser via the VITE_ prefix.
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxx
VITE_MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxx

# Resend transactional email (Track A5) — access link sent on webhook paid.
# EMAIL_FROM must be a Resend-verified sender. For first-time testing use
# onboarding@resend.dev (works without domain verification); for production
# use your verified domain e.g. Peta Bintang Anakku <no-reply@petabintang.com>.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# (Future) WhatsApp bot — OpenWA (Track C)
# WA_WEBHOOK_SECRET=

# (Future) Gemini LLM for WA bot (Track C)
# GEMINI_API_KEY=
