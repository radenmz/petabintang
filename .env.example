# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Server
PORT=3000
NODE_ENV=development

# Absolute public base URL of the app (no trailing slash). Used to build the
# access link in the post-purchase email so the URL is always correct even if
# the reverse proxy does not forward X-Forwarded-* headers. Falls back to the
# request host when empty. Production example: https://petabintang.com
PUBLIC_BASE_URL=

# Midtrans (Track A3)
# Per Midtrans docs (current): sandbox & production keys are NOT distinguished
# by prefix anymore — both look like "Mid-server-…"/"Mid-client-…". Only the
# dashboard environment you copied from + the endpoint domain tell them apart.
# So set MIDTRANS_ENV explicitly to match the keys; it is decoupled from
# NODE_ENV (you can run a prod app build pointing at sandbox, and vice-versa).
#   sandbox → app.sandbox.midtrans.com (no real charges; test payment methods)
#   production → app.midtrans.com (real charges)
MIDTRANS_ENV=sandbox
VITE_MIDTRANS_ENV=sandbox
# SERVER_KEY is server-side only (NEVER expose to the browser).
# CLIENT_KEY is public-safe and shipped to the browser via the VITE_ prefix.
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxx
VITE_MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxx

# Resend transactional email (Track A5) — access link sent on webhook paid.
# EMAIL_FROM must be a Resend-verified sender. For first-time testing use
# onboarding@resend.dev (works without domain verification); for production
# use your verified domain e.g. Peta Bintang Anakku <hello@petabintang.com>.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=Peta Bintang Anakku <hello@petabintang.com>

# Purchase bonus links shown in the access email (optional). Numbered so they
# stay easy to edit; the list ends at the first index missing a label or url.
# Leave all blank to hide the "Bonus Pembelian" section entirely. Read at
# runtime → edit + restart (no rebuild needed).
BONUS_LINK_1_LABEL=Bonus 1 — Panduan Mata Ortu 7 Hari
BONUS_LINK_1_URL=https://drive.google.com/xxxxxxxx
BONUS_LINK_2_LABEL=Bonus 2 — 35 Kegiatan Rumahan
BONUS_LINK_2_URL=https://drive.google.com/yyyyyyyy
BONUS_LINK_3_LABEL=Bonus 3 — Skrip Ngobrol Ortu–Anak
BONUS_LINK_3_URL=https://drive.google.com/zzzzzzzz

# (Future) WhatsApp bot — OpenWA (Track C)
# WA_WEBHOOK_SECRET=

# Admin follow-up dashboard secret (semi-automatic WA reminders).
# Operator opens /admin/wa-followup and enters this value to list overdue
# pending orders + open pre-filled wa.me links. Leave blank to disable the
# /api/admin/* endpoints entirely (fail-closed).
ADMIN_SECRET=

# (Future) Gemini LLM for WA bot (Track C)
# GEMINI_API_KEY=
